# Copy to backend/.env for local development. Never commit .env.
# All values are optional; defaults are shown.

# development | test | production
NODE_ENV=development

# TCP port for the HTTP server (0-65535). 0 picks a random free port.
PORT=3000

# Name reported by GET /health.
SERVICE_NAME=shiftsure-backend

# Firebase project id used to verify ID tokens. Defaults to the emulator-only
# demo project outside production; required (and must not be demo-*) in production.
FIREBASE_PROJECT_ID=demo-shiftsure

# Local Auth and Firestore emulators (see firebase.json). Uncomment both for
# local development only; no credentials are needed against the emulators.
# The Admin SDK reads these directly. Startup fails if either is set in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Against a real (development) Firebase project, Firestore writes and custom-claim
# assignment need Application Default Credentials on the dev machine, e.g.
# `gcloud auth application-default login`. Never commit key files.
